# Fim de linha igual para todo mundo, independente do sistema.
#
# Por quê: quem clona no Windows com core.autocrlf=true receberia os .sh com
# CRLF e o Linux/WSL falharia com "bad interpreter: /usr/bin/env bash^M".
# Aqui os scripts de shell são fixados em LF e os de Windows em CRLF.

* text=auto

*.sh     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.conf   text eol=lf
*.md     text eol=lf
*.ino    text eol=lf
*.py     text eol=lf

*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf
